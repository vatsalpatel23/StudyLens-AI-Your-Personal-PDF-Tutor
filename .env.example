# ==============================================================================
# StudyLens AI - Environment Configuration Template
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDER VALUES WITH SECURE SECRETS
# NEVER COMMIT YOUR REAL .env FILE OR PRODUCTION SECRETS TO VERSION CONTROL!
# ==============================================================================

# Application Environment
# Options: development, staging, production
ENVIRONMENT=development
DEBUG=false
APP_NAME="StudyLens AI — Your Personal PDF Tutor"
APP_VERSION=1.0.0

# Server Binding
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated exact origins, NO wildcard '*' in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Authentication (Argon2id + JWT)
# Generate a cryptographically strong 64-character secret using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting (Token Bucket / Sliding Window)
# Global rate limit per client IP (requests per minute)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=30

# File Upload Security Controls
MAX_UPLOAD_SIZE_BYTES=20971520   # 20 MB limit
MAX_PDF_PAGES=100                 # Maximum allowed pages per document (prevents DoS)
ALLOWED_MIME_TYPES=application/pdf
STORAGE_DIR=backend/storage/uploads
TEMP_DIR=backend/storage/temp

# Database Configuration
# Default: Zero-configuration SQLite with Write-Ahead Logging (WAL)
DATABASE_URL=sqlite:///./backend/storage/studylens.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://studylens_user:STRONG_PASSWORD_HERE@localhost:5432/studylens_prod

# AI / LLM Provider Configuration
# Supported providers: "mock" (for deterministic local testing & offline use), "gemini" (Google Gemini)
AI_PROVIDER=mock
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_SECONDS=30

# Vector Store Configuration
VECTOR_SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
