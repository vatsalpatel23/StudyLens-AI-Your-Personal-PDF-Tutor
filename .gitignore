# ==============================================================================
# StudyLens AI - Production Security .gitignore
# Prevents accidental leak of credentials, private study materials, and build artifacts
# ==============================================================================

# 1. Environment & Secret Configuration Files (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
*.env
secrets.json
service-account*.json
*.pem
*.key
*.cert
*.crt
id_rsa*
*.pfx

# 2. Python Virtual Environments & Packages
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. User Uploads, Documents & Private Study Materials (CRITICAL: NEVER COMMIT)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/temp/*
!backend/storage/temp/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/vector_db/*
!data/vector_db/.gitkeep
*.pdf
*.docx
*.txt
*.pptx
*.epub
# Explicitly allow requirements.txt
!requirements.txt
!backend/requirements.txt
# Allow only safe synthetic test fixtures
!backend/tests/fixtures/*.pdf

# 4. Databases & Vector Indexes
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
chroma/
vector_store/
faiss_index/

# 5. Node / Frontend Build Outputs & Dependencies
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Testing, Coverage & Security Reports
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
test-results/
playwright-report/
test-results/
.scannerwork/
bandit_report.json
gitleaks_report.json

# 7. IDE & OS Metadata
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. Logs & Diagnostics
logs/
*.log
backend/storage/logs/*
!backend/storage/logs/.gitkeep
